# Horizon News server runtime template.
# Copy to .env on the server and fill real values there. Never commit .env.

HORIZON_AI_API_KEY=
HORIZON_AI_BASE_URL=https://your-openai-compatible-gateway/v1
HORIZON_AI_MODEL=

# Optional GitHub API quota for release/source collection.
HORIZON_GITHUB_TOKEN=

# Publish target. The default "pages" remote should point to the GitHub repo
# watched by Cloudflare Pages.
HORIZON_PUBLISH_REMOTE=pages
HORIZON_PUBLISH_BRANCH=main
HORIZON_PUBLISH_HOURS=24

# Server runner controls.
HORIZON_AUTO_PULL=0
HORIZON_UV_SYNC=1
UV_CACHE_DIR=.uv-cache
